# ============================================================================
# FitAI Backend Configuration
# ============================================================================
# This file contains all environment variables required for FitAI backend.
# Copy this file to .env and fill in your actual values.
# NEVER commit .env file to version control.
# ============================================================================

# ============================================================================
# DATABASE CONFIGURATION (REQUIRED)
# ============================================================================
# PostgreSQL connection string
# Format: postgresql+psycopg://username:password@host:port/database
# Examples:
#   - Local without password: postgresql+psycopg://postgres@localhost:5432/fitai_db
#   - Local with password: postgresql+psycopg://user:password@localhost:5432/fitai_db
#   - Docker: postgresql+psycopg://fitai_user:password@db:5432/fitai_db
#   - Remote: postgresql+psycopg://user:pass@prod.db.host:5432/fitai_db
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/fitai_db

# ============================================================================
# JWT AUTHENTICATION (REQUIRED)
# ============================================================================
# Secret key for signing JWT tokens
# IMPORTANT: Use a strong, random key for production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Minimum length: 32 characters
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars

# JWT algorithm (HS256 is recommended)
ALGORITHM=HS256

# Access token expiration time in minutes (1-1440, default: 15)
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Refresh token expiration time in days (1-365, default: 7)
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================
# Application name
APP_NAME=FitAI

# Application version
APP_VERSION=1.0.0

# Environment mode: development, staging, production
# development: Debug mode ON, auto-reload ON
# production: Debug mode OFF, auto-reload OFF
ENVIRONMENT=development

# Enable debug mode (more detailed errors, auto-reload)
DEBUG=True

# ============================================================================
# API CONFIGURATION
# ============================================================================
# API v1 route prefix
API_V1_PREFIX=/api/v1

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
# Comma-separated list of allowed CORS origins
# Examples:
#   - Local development: http://localhost:5173,http://localhost:3000
#   - Production: https://fitai.com,https://app.fitai.com
#   - Both: http://localhost:5173,https://fitai.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================================================
# GEMINI AI CONFIGURATION (OPTIONAL FOR AI COACH ENHANCEMENTS)
# ============================================================================
# Get your API key from https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ============================================================================
# NOTES
# ============================================================================
# 1. DATABASE_URL and SECRET_KEY are REQUIRED for the application to start
# 2. All other variables have sensible defaults for development
# 3. For production, update ENVIRONMENT=production and DEBUG=False
# 4. Never commit this file to version control
# 5. Use separate .env files for different environments:
#    - .env (local development)
#    - .env.staging (staging server)
#    - .env.production (production server)
# ============================================================================
